{"nodes": [{"id": "doc_infinite_scroll_05_api_design_cursor_based_pagination", "label": "Cursor-Based Pagination", "file_type": "concept", "source_file": "doc/infinite-scroll/05-api-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cursor opaco (base64 do estado interno do backend). Zero duplicatas, zero itens pulados. Padr\u00e3o Twitter/X, Instagram, Slack, Stripe APIs. Recomendado para quando houver API pr\u00f3pria."}, {"id": "doc_infinite_scroll_05_api_design_offset_pagination", "label": "Offset-Based Pagination", "file_type": "concept", "source_file": "doc/infinite-scroll/05-api-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adequado para datasets est\u00e1veis. Problema: duplicatas e itens pulados quando h\u00e1 inser\u00e7\u00f5es/remo\u00e7\u00f5es entre p\u00e1ginas."}, {"id": "doc_infinite_scroll_05_api_design_type_metadata", "label": "type-metadata.ts (static mappings)", "file_type": "code", "source_file": "doc/infinite-scroll/05-api-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mapa est\u00e1tico para campos sem equivalente na Pok\u00e9API: cardColor, heroColor, types[].label (PT-BR), types[].color/textColor \u2014 tudo derivado do tipo prim\u00e1rio."}, {"id": "doc_infinite_scroll_05_api_design_acoplamento_forte", "label": "UI/Data Source Decoupling Pattern", "file_type": "concept", "source_file": "doc/infinite-scroll/05-api-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Componentes recebem dados via props; n\u00e3o sabem de onde vieram. page.tsx \u2192 service \u2192 props \u2192 component. Troca de fonte de dados afeta apenas page.tsx, zero mudan\u00e7as nos componentes."}, {"id": "doc_infinite_scroll_05_api_design_favorites_store", "label": "Favorites Store (single source of truth)", "file_type": "code", "source_file": "doc/infinite-scroll/05-api-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "use-favorites.ts + favorites-store.ts (localStorage) como \u00fanica fonte de verdade para favoritos. Toggle na lista e no detalhe leem do mesmo store \u2014 imposs\u00edvel divergir."}, {"id": "doc_infinite_scroll_05_api_design_thundering_herd", "label": "Thundering Herd Problem", "file_type": "concept", "source_file": "doc/infinite-scroll/05-api-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "M\u00faltiplos clients fazem o mesmo request quando cache expira. SSG resolve para HTML \u2014 CDN serve arquivo est\u00e1tico sem bater na origin. Service Worker adiciona cache local por device."}, {"id": "doc_infinite_scroll_05_api_design_stale_while_revalidate", "label": "Stale-While-Revalidate Pattern", "file_type": "concept", "source_file": "doc/infinite-scroll/05-api-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CDN serve cache imediatamente enquanto revalida em background. Usu\u00e1rio nunca espera. Padr\u00e3o Cloudflare e Vercel Edge Network. Cache-Control: public, max-age=300, stale-while-revalidate=60."}], "edges": [{"source": "doc_infinite_scroll_05_api_design_cursor_based_pagination", "target": "doc_infinite_scroll_05_api_design_offset_pagination", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doc/infinite-scroll/05-api-design.md", "source_location": null, "weight": 1.0}, {"source": "doc_infinite_scroll_05_api_design_type_metadata", "target": "agents_pokeapi_v2", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doc/infinite-scroll/05-api-design.md", "source_location": null, "weight": 1.0}, {"source": "doc_infinite_scroll_05_api_design_acoplamento_forte", "target": "doc_infinite_scroll_04_arquitetura_separation_of_concerns", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "doc/infinite-scroll/05-api-design.md", "source_location": null, "weight": 1.0}, {"source": "doc_infinite_scroll_05_api_design_favorites_store", "target": "doc_infinite_scroll_05_api_design_acoplamento_forte", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doc/infinite-scroll/05-api-design.md", "source_location": null, "weight": 1.0}, {"source": "doc_infinite_scroll_05_api_design_thundering_herd", "target": "readme_force_static_ssg", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doc/infinite-scroll/05-api-design.md", "source_location": null, "weight": 1.0}, {"source": "doc_infinite_scroll_05_api_design_stale_while_revalidate", "target": "doc_infinite_scroll_05_api_design_thundering_herd", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doc/infinite-scroll/05-api-design.md", "source_location": null, "weight": 1.0}, {"source": "doc_infinite_scroll_05_api_design_cursor_based_pagination", "target": "doc_infinite_scroll_02_abordagens_react_query_use_infinite_query", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "doc/infinite-scroll/05-api-design.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "ten_classic_data_problems", "label": "10 Classic Data Management Problems & Solutions", "nodes": ["doc_infinite_scroll_01_problema_n_plus_one_query", "doc_infinite_scroll_05_api_design_thundering_herd", "doc_infinite_scroll_05_api_design_acoplamento_forte", "doc_infinite_scroll_05_api_design_favorites_store"], "relation": "participate_in", "confidence